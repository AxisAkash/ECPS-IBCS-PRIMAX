# ECPS frontend prototype configuration (copy to .env.local). No secrets are required to run the demo.
# "mock" uses the in-browser demonstration adapter; "http" is a scaffold for a future .NET REST API.
NEXT_PUBLIC_ECPS_API_MODE=mock
# Base URL of a future ECPS REST gateway (not used in mock mode)
NEXT_PUBLIC_ECPS_API_BASE_URL=
# Google Maps key — supplied by RAJUK per TOR 2.3. Leave blank to use the simulated map.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
